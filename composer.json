{
    "name": "componenta/auth",
    "description": "Transport-neutral authentication contracts and orchestration for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/clock": "^1.1.0",
        "componenta/identity": "^1.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Auth\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "2.1.x-dev",
            "dev-auth-3": "3.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Auth\\Tests\\": "tests/"
        }
    }
}
