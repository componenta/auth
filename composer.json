{
    "name": "componenta/auth",
    "description": "Authentication contracts and helpers for Componenta applications",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "componenta/arrayable": "^1.0",
        "componenta/clock": "^1.0",
        "componenta/config": "^2.0.2",
        "componenta/di": "^4.0.2",
        "componenta/identity": "^1.0",
        "componenta/password": "^1.0",
        "cycle/database": "^2.22",
        "lcobucci/jwt": "^5.6",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Auth\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Auth\\ConfigProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist"
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Auth\\Tests\\": "tests/"
        }
    }
}
